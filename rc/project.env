# rc/project.env — the ONLY file that differs between projects.
# Plain bash, sourced by every rc script. Commands run from the repo root
# with the project env already on PATH (python, node, openclaw, codex, claude).
#
# HarnessAudit is an API-driven agent-harness benchmark: every model call goes to a
# remote API (OpenRouter / OpenAI / Anthropic). No local inference, so CPU-only.
#
# COST GUARD: the code now defaults to fully local inference (HA_INFERENCE_MODE=local_only).
# The SMOKE/FULL commands below use hosted harnesses (OpenClaw/Codex), so they stop
# with a CostGuardError unless you opt in explicitly at submit time:
#   HA_INFERENCE_MODE=paid_opt_in HARNESS=codex MODEL=gpt-5.4 rc/submit.sh full
# Local Qwen jobs (GPU, no API charges) use scripts/hpc/ instead, e.g.
#   scripts/hpc/submit_campaign.sh --profile a100_single     (see docs/SLURM_CLUSTER_GUIDE.md)

# ---- what to run ----
PREP_CMD=""      # nothing to download: tasks and fixtures are in the repo

# One task (dl-t4, 3 agents), cheap model, no LLM judge; prints the task log at the end.
# Default: OpenClaw + qwen3.5-plus via OpenRouter (the same harness as FULL_CMD).
# Override at submit time, e.g.  HARNESS=codex MODEL=gpt-5.4-mini rc/submit.sh smoke
# If the API call fails, the task log shows "runner error: ..." and the job exits non-zero.
SMOKE_CMD='node --version && openclaw --version && codex --version && claude --version \
  && H=${HARNESS:-openclaw} M=${MODEL:-qwen3.5-plus} \
  && HARNESS=$H MODEL=$M TASK_FILE=multi_agent/tasks/daily_life/wellness/dl-t4.yaml \
     SKIP_JUDGE=1 TASK_WORKERS=1 OUTPUT_DIR=results/smoke TRACE_DIR=results/smoke_traces \
     PYTHON_CMD=python bash multi_agent/run_ma.sh; rc=$?; \
  tail -n 40 "results/smoke/_run_logs/$H/${M//\//__}/dl-t4.log"; exit $rc'

# Full multi-agent sweep (210 tasks). SKIP_EXISTING=1 skips tasks that already have an
# error-free result JSON, so resubmitting the same command resumes (and retries failures).
# Submit-time variables reach the job (sbatch exports the submitting shell's environment);
# FULL_CMD only fills defaults (${VAR:-default}) and never overwrites:
#   HARNESS (openclaw)  MODEL (gpt-5.4)  JUDGE_MODEL (gpt-5.4)  MASP_JUDGE_PROVIDER (openai)
#   TASK_WORKERS (2)  JUDGE_WORKERS (4)  OUTPUT_DIR (results/full)  TRACE_DIR (results/full_traces)
# e.g.  HARNESS=codex MODEL=gpt-5.4 rc/submit.sh full
# Check what a submission would run, without running it:
#   DRY_RUN=1 HARNESS=codex MODEL=gpt-5.4 rc/submit.sh full --time=00:05:00
# (if you raise TASK_WORKERS, also pass --cpus-per-task and --mem, see below).
# Use a separate OUTPUT_DIR per judge setup: SKIP_EXISTING looks at OUTPUT_DIR/HARNESS/MODEL
# only, so two judge models writing to the same directory would skip each other's tasks.
#
# Alternative FULL: Codex agents + Qwen judge via OpenRouter (the scripts/run_qwen_judge.py
# setup, swept over all tasks; needs OPENAI_API_KEY for the agents and OPENROUTER_API_KEY):
#   MASP_JUDGE_PROVIDER=openrouter HARNESS=codex MODEL=gpt-5.6-sol JUDGE_MODEL=qwen/qwen3-8b \
#   OUTPUT_DIR=results/full_qwen_judge TRACE_DIR=results/full_qwen_judge_traces rc/submit.sh full
# Single-task versions: rc/submit.sh "python scripts/run_qwen_judge.py"  (probe the judge
# first: rc/submit.sh "python scripts/probe_qwen_judge.py"), or the README demo
# rc/submit.sh "python scripts/run_codex_benchmark.py".
FULL_CMD='node --version && openclaw --version && codex --version && claude --version \
  && SKIP_EXISTING=1 TASK_WORKERS=${TASK_WORKERS:-2} JUDGE_WORKERS=${JUDGE_WORKERS:-4} \
     OUTPUT_DIR=${OUTPUT_DIR:-results/full} TRACE_DIR=${TRACE_DIR:-results/full_traces} \
     PYTHON_CMD=python bash multi_agent/run_ma.sh'

# ---- checks ----
CHECK_IMPORTS="multi_agent single_agent clawteam agents openai mcp yaml dotenv pydantic"
# run_ma.sh appends one "done|error|fail <task>" line per finished task to this file.
RESULT_GLOB="results/*/progress_*.txt"

# ---- resources (any can be overridden per submit: rc/submit.sh full --mem=32G) ----
# CPUS = TASK_WORKERS (2) x JUDGE_WORKERS (4) = 8. A running task is one Python
# orchestrator + one agent CLI process per role (3-7 roles, mostly 4-5) + MCP servers;
# judge calls run JUDGE_WORKERS at a time. Work is mostly waiting on HTTP, but each
# openclaw agent start-up burns ~2 cores for a few seconds (measured 184% CPU on PI).
# MEM: measured on PI, one `openclaw agent` process peaks at ~0.76 GB RSS and each Python
# process ~0.1 GB, so a task needs ~4.5 GB typically and ~6.5 GB for the one 7-agent task.
# 2 concurrent tasks -> <=13 GB, so 16G. For TASK_WORKERS=4 use --cpus-per-task=16 --mem=32G.
CPUS=8
MEM=16G
GPUS=0                        # API-only: no local model inference
TIME_CHECK=00:15:00
TIME_PREP=00:15:00
TIME_SMOKE=00:30:00
TIME_FULL=1-00:00:00          # ~210 tasks / 2 workers x ~5 min = ~9 h; resumable: resubmit if it hits the limit

# ---- secrets: 1 = load ~/.config/rit-secrets/<repo>.env inside jobs ----
NEEDS_SECRETS=1

# ---- runs inside every job after the env is activated ----
cluster_env() {
  # RIT has no interactive CLI logins: always authenticate harness CLIs with API keys.
  export CODEX_AUTH_MODE=api_key
  export CLAUDE_CODE_AUTH_MODE=api_key
  export DISABLE_AUTOUPDATER=1          # keep the pinned claude-code version
  case "$CLUSTER" in
    tigris) : ;;
    sporc)  : ;;
  esac
}

# ---- non-Python tools, installed per cluster by rc/setup.sh (re-run when this file changes) ----
# Versions = what works on PI (node 24.16.0, openclaw 2026.9.5, codex 0.156.1);
# openclaw requires node >=24.16.0 <25. claude-code was not installed on PI; pinned to
# the current release (2.1.325), installed and `--version`-checked on PI.
extra_setup() {
  rc_install_node 24.16.0
  npm install -g --no-fund --no-audit \
    openclaw@2026.9.5 \
    @openai/codex@0.156.1 \
    @anthropic-ai/claude-code@2.1.325
}

# ---- rarely needed: partition names if RIT renames them ----
# PARTITION_SPORC=sporc-gpu; CPU_PARTITION_SPORC=sporc; PARTITION_TIGRIS=tigris; CPU_PARTITION_TIGRIS=tigris
